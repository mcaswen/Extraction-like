      "hotspots": [
        {
          "title": "喷管热壁",
          "text": "内壁直接接触高温燃气。喷管轮廓引导燃气膨胀、加速，热量则穿过壁面传向冷却通道。轮廓与热管理共同影响喷管的工作。",
          "view": "cutaway",
          "groups": [
            "Hotwall"
          ],
          "anchor": "R01_Hotspot_1"
        },
        {
          "title": "连续冷却通道",
          "text": "推进剂流经热壁附近的封闭通道，吸收壁面传来的热量。通道沿喷管轮廓延伸，使冷却流体能够接近需要保护的壁面。",
          "view": "cutaway",
          "groups": [
            "ChannelLands"
          ],
          "anchor": "R01_Hotspot_2"
        },
        {
          "title": "通道外套与护罩",
          "text": "紧贴冷却通道的连续外套与热壁共同封闭流路。外侧分段护罩位于通道外套之外，沿周向围绕喷管布置。",
          "view": "assembled",
          "groups": [
            "JacketFixed",
            "JacketWindow",
            "EquipmentJacket",
            "EquipmentJacketWindow"
          ],
          "anchor": "R01_Hotspot_3"
        },
        {
          "title": "集流环与关联管路",
          "text": "集流环连接多条冷却通道，与外部管路共同组织流体的分配和汇集。沿接口与管路观察，可以理解冷却结构与供给系统之间的联系。",
          "view": "assembled",
          "groups": [
            "Manifolds",
            "FeedLine",
            "ReturnLine",
            "EquipmentCoolingServices",
            "EquipmentServiceCollar"
          ],
          "anchor": "R01_Hotspot_4"
        }
      ]
    },
